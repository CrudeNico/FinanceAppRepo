rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /history/{id} {
      allow read, write: if true;
    }
    match /app/{id} {
      allow read, write: if true;
    }
    match /profiles/{id} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
